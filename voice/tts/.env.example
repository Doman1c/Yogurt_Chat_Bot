# Paths are local-only. Do not commit the populated .env file.
YOGURT_TTS_PYTHON=python
YOGURT_GPT_SOVITS_HOME=C:/path/to/GPT-SoVITS
YOGURT_TTS_GPT_MODEL=C:/path/to/ratio_80_20-e15.ckpt
YOGURT_TTS_SOVITS_MODEL=C:/path/to/ratio_80_20_e8_s120.pth
YOGURT_TTS_MODEL_VERSION=v2Pro
YOGURT_TTS_EMOTION_REGISTRY=C:/path/to/private/emotion_registry.v1.json
YOGURT_TTS_EMOTION_REFERENCE_ROOT=C:/path/to/private
YOGURT_TTS_HOST=127.0.0.1
YOGURT_TTS_PORT=17861
# Baseline sampling; tune only through an A/B run, never by changing code.
YOGURT_TTS_TOP_K=15
YOGURT_TTS_TOP_P=1.0
YOGURT_TTS_TEMPERATURE=1.0
YOGURT_TTS_TEXT_SPLIT_METHOD=cut5
YOGURT_TTS_REPETITION_PENALTY=1.35
YOGURT_TTS_SPEED_FACTOR=1.0
