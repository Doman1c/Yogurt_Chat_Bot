{
  "plugins": {
    "entries": {
      "yogurt-social-injector": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true,
          "allowPromptInjection": true,
          "timeouts": {
            "before_prompt_build": 12000
          }
        },
        "config": {
          "enabled": true,
          "pythonPath": "/usr/bin/python3",
          "repoPath": "/Users/your-name/Yogurt_Chat_Bot",
          "dbPath": "/Users/your-name/.openclaw/yogurt-social/memory.sqlite3",
          "defaultUserId": "owner",
          "senderMap": {},
          "ownerSenderIds": [],
          "unknownSenderPolicy": "default",
          "allowedChannels": [],
          "onlyUserTurns": true,
          "timeoutMs": 2500,
          "maxMemories": 3,
          "stickerEnabled": false,
          "stickerConfigPath": "/Users/your-name/Yogurt_Chat_Bot/social_layer/config/stickers.json",
          "stickerSelectionMode": "auto",
          "autoMemoryEnabled": false,
          "autoMemoryPromotionThreshold": 0.78,
          "autoMemoryTimeoutMs": 2500,
          "multiBubbleEnabled": false,
          "multiBubbleMinChars": 24,
          "multiBubbleMaxChars": 360,
          "multiBubbleMaxBubbles": 3,
          "multiBubbleDelayMs": 420,
          "conversationStateEnabled": false,
          "conversationStateTimeoutMs": 2500,
          "conversationStateTopicTtlMinutes": 60,
          "conversationStateMoodTtlMinutes": 30,
          "conversationStateThreadTtlMinutes": 1440,
          "conversationStateMaxOpenThreads": 5,
          "conversationStateMaxRecentActions": 6,
          "responsePlannerEnabled": false,
          "responsePlannerMaxContextChars": 1600,
          "memoryRecallGateEnabled": false,
          "memoryRecallMinScore": 0.48,
          "memoryRecallCooldownTurns": 8,
          "memoryRecallSameMemoryCooldownTurns": 20,
          "memoryRecallMaxCandidates": 5,
          "unifiedOutboundShadowEnabled": false
        }
      }
    }
  }
}
