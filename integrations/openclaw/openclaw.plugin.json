{
  "id": "yogurt-social-injector",
  "name": "Yogurt Social Injector",
  "description": "Injects Yogurt social context and delivers bounded V2 stickers.",
  "version": "0.3.0",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": ["choose_sticker"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "pythonPath": {
        "type": "string",
        "default": "python3"
      },
      "repoPath": {
        "type": "string"
      },
      "dbPath": {
        "type": "string",
        "default": "~/.openclaw/yogurt-social/memory.sqlite3"
      },
      "defaultUserId": {
        "type": "string",
        "default": "owner"
      },
      "senderMap": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "default": {}
      },
      "ownerSenderIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "unknownSenderPolicy": {
        "type": "string",
        "enum": ["default", "pseudonymous", "skip"],
        "default": "default"
      },
      "allowedChannels": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "onlyUserTurns": {
        "type": "boolean",
        "default": true
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 250,
        "maximum": 10000,
        "default": 2500
      },
      "maxMemories": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10,
        "default": 3
      },
      "stickerEnabled": {
        "type": "boolean",
        "default": false
      },
      "stickerConfigPath": {
        "type": "string",
        "default": "social_layer/config/stickers.json"
      },
      "stickerSelectionMode": {
        "type": "string",
        "enum": ["auto", "tool"],
        "default": "auto"
      }
    }
  }
}
