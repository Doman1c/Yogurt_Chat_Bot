{
  "input_dir": "assets/stickers/inbox",
  "output_dir": "assets/stickers/images",
  "thumbnail_dir": "assets/stickers/thumbnails",
  "catalog_path": "assets/stickers/stickers.json",
  "runtime_dir": "runtime/sticker_tagger",
  "provider": {
    "type": "ollama_vlm",
    "base_url": "http://127.0.0.1:11434",
    "model": "configure-me",
    "timeout_seconds": 120
  },
  "processing": {
    "normalize_format": "webp",
    "max_dimension": 1600,
    "thumbnail_dimension": 320,
    "strip_metadata": true,
    "deduplicate_by_sha256": true
  },
  "classification": {
    "review_required": true,
    "auto_approve_threshold": 0.92,
    "max_keywords": 12,
    "max_ocr_chars": 200,
    "retry_count": 1
  },
  "watch": {
    "enabled": false,
    "poll_interval_seconds": 5
  }
}
