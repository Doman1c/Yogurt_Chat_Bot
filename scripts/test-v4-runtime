#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT
TEST_ROOT="$TMP_DIR/plugin-test"
PYTHON_BIN="$(command -v python3)"
mkdir -p "$TEST_ROOT/node_modules/openclaw/plugin-sdk"
cp "$REPO_ROOT/integrations/openclaw/index-v4.ts" "$TEST_ROOT/index-v4.ts"

cat > "$TEST_ROOT/node_modules/openclaw/package.json" <<'JSON'
{
  "name": "openclaw",
  "version": "0.0.0-test",
  "type": "module",
  "exports": {
    "./plugin-sdk/plugin-entry": "./plugin-sdk/plugin-entry.js"
  }
}
JSON

cat > "$TEST_ROOT/node_modules/openclaw/plugin-sdk/plugin-entry.js" <<'JS'
export function definePluginEntry(definition) {
  return definition;
}
JS

cat > "$TEST_ROOT/index-v3.ts" <<'TS'
export default {
  register(api: any) {
    api.on(
      "message_sending",
      async (event: any) => {
        api.trace.push({ step: "multi-bubble", text: event.content });
        return { cancel: true };
      },
      { priority: 70 },
    );
  },
};
TS

cat > "$TEST_ROOT/sticker-v21-utils.ts" <<'TS'
export function assistantTextFromEvent(event: any): string | undefined {
  return typeof event?.content === "string" ? event.content : undefined;
}
TS

cat > "$TEST_ROOT/sticker-plugin-utils.ts" <<'TS'
export function asRecord(value: unknown): Record<string, unknown> {
  return value && typeof value === "object" && !Array.isArray(value)
    ? value as Record<string, unknown>
    : {};
}

export function optionalString(value: unknown): string | undefined {
  return typeof value === "string" && value.trim() ? value.trim() : undefined;
}

export function isNativeVoiceContext(ctx: any, event?: any): boolean {
  const sessionKey = optionalString(ctx?.sessionKey) || optionalString(event?.sessionKey);
  return Boolean(sessionKey && sessionKey.startsWith("native:voice:"));
}

export function senderIdFromContext(ctx: any): string | undefined {
  return optionalString(ctx?.senderId);
}

export function channelFromContext(ctx: any): string {
  return optionalString(ctx?.channelId) || "unknown";
}

export function channelIsAllowed(): boolean {
  return true;
}

export function contextAliases(
  ctx: any,
  channel: string,
  senderId?: string,
): string[] {
  const values: string[] = [];
  if (ctx?.sessionKey) values.push(`session:${ctx.sessionKey}`);
  if (senderId) values.push(`sender:${channel}:${senderId}`);
  return values;
}

export function preferredPolicyKey(aliases: string[]): string {
  return aliases.find((value) => value.startsWith("session:")) || aliases[0] || "unknown";
}

export function resolveUserId(): string {
  return "owner";
}

export function readConfig(api: any): any {
  return {
    enabled: true,
    pythonPath: process.env.V4_TEST_PYTHON || "python3",
    repoPath: api.testRoot,
    dbPath: `${api.testRoot}/state.sqlite3`,
    allowedChannels: [],
    onlyUserTurns: true,
    defaultUserId: "owner",
    senderMap: {},
    ownerSenderIds: [],
    unknownSenderPolicy: "default",
  };
}
TS

mkdir -p "$TEST_ROOT/social_layer/src/yogurt_social"
cat > "$TEST_ROOT/social_layer/src/yogurt_social/__init__.py" <<'PY'
"""Temporary test package for the V4 observer runtime simulation."""
PY
cat > "$TEST_ROOT/social_layer/src/yogurt_social/conversation_state_observer.py" <<'PY'
import json
import os
import sys

request = json.load(sys.stdin)
with open(os.environ["V4_OBSERVER_LOG"], "a", encoding="utf-8") as handle:
    handle.write(json.dumps(request, ensure_ascii=False) + "\n")
phase = request["phase"]
state = {
    "current_topic": "记忆召回门控",
    "dialogue_act": "plan",
    "user_mood": "neutral",
    "interaction_mode": "technical",
    "open_threads": ["实现 V4.2 记忆召回门控"],
    "last_response_pattern": None if phase == "user" else "concise",
    "state_version": 1 if phase == "user" else 2,
}
response_plan = None
response_plan_context = ""
memory_recall = None
if phase == "user" and request.get("include_response_plan") is True:
    response_plan = {
        "plan_version": "4.1",
        "dialogue_act": "plan",
        "primary_goal": "advance_current_project",
        "reply_length": "medium",
        "ask_followup": False,
        "bubble_target": 2,
        "sticker_preference": "neutral",
        "state_version": 1,
    }
    response_plan_context = "\n".join([
        "[Yogurt Response Plan V4.1]",
        "本轮行为：plan",
        "首要目标：推进当前项目的下一步",
        "主动追问：否",
    ])
if phase == "user" and request.get("include_memory_recall") is True:
    memory_recall = {
        "mode": "shadow_only",
        "decision": "allow",
        "threshold": 0.48,
        "explicit_request": False,
        "turn_index": 1,
        "state_version": 1,
        "cooldown_remaining": 0,
        "same_memory_cooldown_remaining": 0,
        "reasons": ["candidate_layer:stable", "candidate_kind:fact", "gate_allow"],
        "candidate": {
            "layer": "stable",
            "kind": "fact",
            "source_id": 7,
            "memory_key": "model",
            "score": 0.731,
            "lexical_score": 0.75,
            "continuity_score": 0.5,
            "quality_score": 1.0,
        },
    }
print(json.dumps({
    "ok": True,
    "phase": phase,
    "state": state,
    "response_plan": response_plan,
    "response_plan_context": response_plan_context,
    "memory_recall": memory_recall,
}, ensure_ascii=False))
PY

V4_TEST_PYTHON="$PYTHON_BIN" \
V4_OBSERVER_LOG="$TMP_DIR/observer.jsonl" \
node --experimental-strip-types --input-type=module - "$TEST_ROOT" "$REPO_ROOT" <<'JS'
import assert from "node:assert/strict";
import { existsSync, readFileSync } from "node:fs";
import { pathToFileURL } from "node:url";

const testRoot = process.argv[2];
const repoRoot = process.argv[3];
const plugin = (await import(pathToFileURL(`${testRoot}/index-v4.ts`))).default;
const nativeGuard = await import(pathToFileURL(`${testRoot}/sticker-plugin-utils.ts`));
const repositoryGuard = await import(
  pathToFileURL(`${repoRoot}/integrations/openclaw/sticker-plugin-utils.ts`),
);
const hooks = new Map();
const logs = [];
const trace = [];
const api = {
  testRoot,
  trace,
  pluginConfig: {
    conversationStateEnabled: true,
    conversationStateTimeoutMs: 2500,
    responsePlannerEnabled: true,
    responsePlannerMaxContextChars: 1600,
    memoryRecallGateEnabled: true,
    memoryRecallMinScore: 0.48,
    memoryRecallCooldownTurns: 8,
    memoryRecallSameMemoryCooldownTurns: 20,
    memoryRecallMaxCandidates: 5,
  },
  logger: {
    info(message) { logs.push(String(message)); },
    warn(message) { logs.push(String(message)); },
  },
  on(name, handler, options = {}) {
    const items = hooks.get(name) || [];
    items.push({ handler, priority: options.priority || 0 });
    hooks.set(name, items);
  },
};

plugin.register(api);
assert.deepEqual(
  (hooks.get("message_sending") || [])
    .map((item) => item.priority)
    .sort((a, b) => b - a),
  [75, 70],
);

async function dispatch(name, event, ctx) {
  let result;
  const ordered = [...(hooks.get(name) || [])].sort(
    (left, right) => right.priority - left.priority,
  );
  for (const item of ordered) {
    const current = await item.handler(event, ctx);
    if (current !== undefined) result = current;
  }
  return result;
}

const inboundCtx = {
  channelId: "openclaw-weixin",
  senderId: "wx-owner@im.wechat",
  sessionKey: "session-v42",
};
const promptResult = await dispatch(
  "before_prompt_build",
  { prompt: "开始 V4.2 Memory Recall Gate" },
  inboundCtx,
);
assert.ok(promptResult?.prependContext?.startsWith("[Yogurt Response Plan V4.1]"));
assert.ok(promptResult.prependContext.includes("主动追问：否"));
assert.ok(!promptResult.prependContext.includes("source_id"));
assert.ok(!promptResult.prependContext.includes("memory_key"));
assert.ok(!promptResult.prependContext.includes("qwen"));

const fullReply = "召回门控的影子模式已经准备好了，我们开始测试。";
const result = await dispatch(
  "message_sending",
  {
    content: fullReply,
    to: "wx-owner@im.wechat",
    metadata: { channel: "openclaw-weixin" },
  },
  { channelId: "openclaw-weixin" },
);
assert.equal(result.cancel, true);
assert.deepEqual(trace, [{ step: "multi-bubble", text: fullReply }]);

await dispatch(
  "message_sending",
  {
    content: "开始测试。",
    to: "wx-owner@im.wechat",
    metadata: { channel: "openclaw-weixin" },
  },
  { channelId: "openclaw-weixin" },
);

const nativeResult = await dispatch(
  "before_prompt_build",
  { prompt: "native turn must not reach B.7" },
  { channelId: "native", sessionKey: "native:voice:smoke" },
);
assert.equal(nativeResult, undefined);
for (const guard of [nativeGuard, repositoryGuard]) {
  assert.equal(guard.isNativeVoiceContext({ sessionKey: "native:voice:abc" }), true);
  assert.equal(guard.isNativeVoiceContext({ sessionKey: "foo-native:voice:abc" }), false);
  assert.equal(guard.isNativeVoiceContext({ sessionKey: "native-other:abc" }), false);
}

assert.ok(
  existsSync(process.env.V4_OBSERVER_LOG),
  `observer log missing; runtime logs: ${logs.join(" | ")}`,
);
const observerLog = readFileSync(process.env.V4_OBSERVER_LOG, "utf8")
  .trim()
  .split("\n")
  .map((line) => JSON.parse(line));
assert.deepEqual(observerLog.map((item) => item.phase), ["user", "assistant"]);
assert.equal(observerLog[0].conversation_key, "session:session-v42");
assert.equal(observerLog[0].include_response_plan, true);
assert.equal(observerLog[0].include_memory_recall, true);
assert.equal(observerLog[1].assistant_reply, fullReply);
assert.ok(logs.some((message) => message.includes("phase=user")));
assert.ok(logs.some((message) => message.includes("v4 response plan ready")));
assert.ok(logs.some((message) => message.includes("v4 memory recall shadow")));
assert.ok(logs.some((message) => message.includes("decision=allow")));
assert.ok(logs.some((message) => message.includes("layer=stable")));
assert.ok(logs.some((message) => message.includes("sourceId=7")));
assert.ok(logs.some((message) => message.includes("phase=assistant")));
assert.equal(
  logs.filter((message) => message.includes("phase=assistant")).length,
  1,
  "child bubbles must not create another assistant observation",
);
console.log("v4.2 shadow recall runtime: ok");
JS
