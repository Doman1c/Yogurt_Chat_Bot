#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT
TEST_ROOT="$TMP_DIR/plugin-test"
mkdir -p "$TEST_ROOT/node_modules/openclaw/plugin-sdk"

cp "$REPO_ROOT/integrations/openclaw/index-v43.ts" "$TEST_ROOT/index-v43.ts"
cp "$REPO_ROOT/integrations/openclaw/outbound-coordinator.ts" "$TEST_ROOT/outbound-coordinator.ts"
cp "$REPO_ROOT/integrations/openclaw/multi-bubble.ts" "$TEST_ROOT/multi-bubble.ts"

cat > "$TEST_ROOT/node_modules/openclaw/package.json" <<'JSON'
{
  "name": "openclaw",
  "version": "0.0.0-test",
  "type": "module",
  "exports": {
    "./plugin-sdk/plugin-entry": "./plugin-sdk/plugin-entry.js"
  }
}
JSON

cat > "$TEST_ROOT/node_modules/openclaw/plugin-sdk/plugin-entry.js" <<'JS'
export function definePluginEntry(definition) {
  return definition;
}
JS

cat > "$TEST_ROOT/sticker-plugin-utils.ts" <<'TS'
export function asRecord(value: unknown): Record<string, unknown> {
  return value && typeof value === "object" && !Array.isArray(value)
    ? value as Record<string, unknown>
    : {};
}

export function optionalString(value: unknown): string | undefined {
  return typeof value === "string" && value.trim() ? value.trim() : undefined;
}

export function channelFromContext(ctx: any): string {
  return optionalString(ctx?.channelId) || "openclaw-weixin";
}

export function senderIdFromContext(ctx: any): string | undefined {
  return optionalString(ctx?.senderId);
}

export function contextAliases(
  ctx: any,
  channel: string,
  senderId?: string,
): string[] {
  const aliases: string[] = [];
  if (ctx?.sessionKey) aliases.push(`session:${ctx.sessionKey}`);
  if (senderId) aliases.push(`sender:${channel}:${senderId}`);
  return aliases;
}
TS

cat > "$TEST_ROOT/index-v4.ts" <<'TS'
export default {
  register(api: any) {
    api.on(
      "before_prompt_build",
      async () => undefined,
      { priority: 60 },
    );

    api.on(
      "before_prompt_build",
      async (event: any) => ({
        prependContext: [
          "[Yogurt Response Plan V4.1]",
          "本轮行为：plan",
          "建议长度：中等",
          `建议气泡数：${String(event?.prompt || "").includes("two") ? 2 : 1}`,
          "表情倾向：中性",
        ].join("\n"),
      }),
      { priority: 50 },
    );

    api.on(
      "message_sending",
      async (event: any) => {
        const content = String(event?.content || "");
        if (content === "sticker-success") {
          api.logger.info(
            "yogurt-social-injector: post-reply sticker selected sticker=test_sticker reason=score_pass",
          );
          api.logger.info(
            "yogurt-social-injector: sticker outbound scheduled trigger=agent_end mode=auto hasTarget=true delayMs=0",
          );
          setTimeout(() => {
            api.logger.info(
              "yogurt-social-injector: sticker media sent trigger=channel_outbound_adapter mode=auto sticker=test_sticker",
            );
          }, 0);
        }
        if (content === "sticker-failure") {
          api.logger.info(
            "yogurt-social-injector: post-reply sticker selected sticker=failed_sticker reason=score_pass",
          );
          api.logger.info(
            "yogurt-social-injector: sticker outbound scheduled trigger=agent_end mode=auto hasTarget=true delayMs=0",
          );
          setTimeout(() => {
            api.logger.warn(
              "yogurt-social-injector: sticker media send failed trigger=channel_outbound_adapter (weixin_send_media_unavailable); text preserved",
            );
          }, 0);
        }
        if (content === "sticker-skipped") {
          api.logger.info(
            "yogurt-social-injector: send decision trigger=agent_end mode=auto shouldSend=false score=4.20 threshold=5.80 intents=casual reasons=below_threshold candidates=2 top=a:4.2 runnerUp=b:3.9",
          );
        }
      },
      { priority: 80 },
    );

    api.on(
      "message_sending",
      async (event: any, ctx: any) => {
        api.legacyCalls += 1;
        if (event?.content === "parent-shadow") {
          await api.testDispatch(
            "message_sending",
            { content: "child-shadow", to: event.to },
            ctx,
          );
          return {
            cancel: true,
            cancelReason: "yogurt_multi_bubble",
            metadata: { bubbleCount: 2 },
          };
        }
        if (String(event?.content || "").includes("legacy-three")) {
          return {
            cancel: true,
            cancelReason: "yogurt_multi_bubble",
            metadata: { bubbleCount: 3 },
          };
        }
        return undefined;
      },
      { priority: 70 },
    );
  },
};
TS

node --experimental-strip-types --input-type=module - "$TEST_ROOT" <<'JS'
import assert from "node:assert/strict";
import { pathToFileURL } from "node:url";

const testRoot = process.argv[2];
const plugin = (await import(pathToFileURL(`${testRoot}/index-v43.ts`))).default;
const hooks = new Map();
const logs = [];
const sent = [];
let failAfter = Number.POSITIVE_INFINITY;
const api = {
  pluginConfig: {
    responsePlannerEnabled: true,
    unifiedOutboundShadowEnabled: true,
    unifiedOutboundEnforceEnabled: false,
    stickerEnabled: false,
    multiBubbleMinChars: 8,
    multiBubbleMaxChars: 360,
    multiBubbleDelayMs: 0,
  },
  legacyCalls: 0,
  config: {},
  runtime: {
    channel: {
      outbound: {
        async loadAdapter() {
          return {
            async sendText({ to, text }) {
              if (sent.length >= failAfter) throw new Error("simulated_send_failure");
              sent.push(text);
              await dispatch(
                "message_sending",
                { content: text, to, metadata: { channel: "openclaw-weixin" } },
                ctx,
              );
            },
          };
        },
      },
    },
  },
  logger: {
    info(message) { logs.push(String(message)); },
    warn(message) { logs.push(String(message)); },
    error(message) { logs.push(String(message)); },
  },
  on(name, handler, options = {}) {
    const items = hooks.get(name) || [];
    items.push({ handler, priority: options.priority || 0 });
    hooks.set(name, items);
  },
};

async function dispatch(name, event, context) {
  let result;
  const ordered = [...(hooks.get(name) || [])].sort(
    (left, right) => right.priority - left.priority,
  );
  for (const item of ordered) {
    const current = await item.handler(event, context);
    if (current !== undefined) result = current;
  }
  return result;
}
api.testDispatch = dispatch;
plugin.register(api);

const ctx = {
  channelId: "openclaw-weixin",
  senderId: "wx-owner@im.wechat",
  sessionKey: "session-v43",
};

await dispatch("before_prompt_build", { prompt: "one" }, ctx);
await dispatch(
  "message_sending",
  {
    content: "legacy-three",
    to: "wx-owner@im.wechat",
    metadata: { channel: "openclaw-weixin" },
  },
  ctx,
);
assert.ok(logs.some((value) => value.includes("v4.3 outbound shadow")));
assert.ok(logs.some((value) => value.includes("actualBubbles=3")));
assert.ok(logs.some((value) => value.includes("matched=false")));
assert.ok(logs.some((value) => value.includes("sticker=skipped")));
assert.ok(logs.every((value) => !value.includes("sticker=unknown")));

logs.length = 0;
await dispatch("before_prompt_build", { prompt: "one" }, ctx);
await dispatch(
  "message_sending",
  {
    content: "parent-shadow",
    to: "wx-owner@im.wechat",
    metadata: { channel: "openclaw-weixin" },
  },
  ctx,
);
assert.equal(
  logs.filter((value) => value.includes("v4.3 outbound shadow")).length,
  1,
  "legacy recursive child bubbles must report only the parent",
);

api.pluginConfig.unifiedOutboundShadowEnabled = false;
api.pluginConfig.unifiedOutboundEnforceEnabled = true;
logs.length = 0;
const callsBeforeSingle = api.legacyCalls;
const singleText = "第一句会保留。第二句不会再被旧系统拆开。";
await dispatch("before_prompt_build", { prompt: "one" }, ctx);
const singleResult = await dispatch(
  "message_sending",
  {
    content: singleText,
    to: "wx-owner@im.wechat",
    metadata: { channel: "openclaw-weixin" },
  },
  ctx,
);
assert.deepEqual(singleResult, { content: singleText, cancel: false });
assert.equal(api.legacyCalls, callsBeforeSingle);
assert.ok(logs.some((value) => value.includes("outbound enforced")));
assert.ok(logs.some((value) => value.includes("actualBubbles=1")));
assert.ok(logs.some((value) => value.includes("enforced_target_applied")));
assert.ok(logs.some((value) => value.includes("hostAction=explicit_passthrough")));
assert.ok(logs.some((value) => value.includes("stickerReason=sticker_disabled")));

logs.length = 0;
sent.length = 0;
failAfter = Number.POSITIVE_INFINITY;
await dispatch("before_prompt_build", { prompt: "two" }, ctx);
const exactResult = await dispatch(
  "message_sending",
  {
    content: "第一句足够自然。第二句也足够自然。",
    to: "wx-owner@im.wechat",
    metadata: { channel: "openclaw-weixin" },
  },
  ctx,
);
assert.equal(exactResult.cancelReason, "yogurt_unified_outbound");
assert.deepEqual(sent, ["第一句足够自然。", "第二句也足够自然。"]);
assert.ok(logs.some((value) => value.includes("targetBubbles=2")));
assert.ok(logs.some((value) => value.includes("actualBubbles=2")));
assert.ok(logs.some((value) => value.includes("matched=true")));
assert.ok(logs.some((value) => value.includes("hostAction=coordinator_delivery")));
assert.equal(
  logs.filter((value) => value.includes("v4.3 outbound enforced")).length,
  1,
  "coordinator child bubbles must not report the parent again",
);

logs.length = 0;
await dispatch("before_prompt_build", { prompt: "two" }, ctx);
const fallbackResult = await dispatch(
  "message_sending",
  {
    content: "```bash\necho hi\n``` legacy-three",
    to: "wx-owner@im.wechat",
    metadata: { channel: "openclaw-weixin" },
  },
  ctx,
);
assert.equal(fallbackResult.cancelReason, "yogurt_multi_bubble");
assert.ok(
  logs.some((value) => value.includes("enforcement_fallback:code_block_passthrough")),
);
assert.ok(logs.some((value) => value.includes("actualBubbles=3")));
assert.ok(logs.some((value) => value.includes("hostAction=legacy_result")));

logs.length = 0;
const naturalFallbackText =
  "这是一段长度足够但是没有句号也没有任何可以安全拆分边界的完整回复文本";
await dispatch("before_prompt_build", { prompt: "two" }, ctx);
const naturalFallbackResult = await dispatch(
  "message_sending",
  {
    content: naturalFallbackText,
    to: "wx-owner@im.wechat",
    metadata: { channel: "openclaw-weixin" },
  },
  ctx,
);
assert.deepEqual(naturalFallbackResult, {
  content: naturalFallbackText,
  cancel: false,
});
assert.ok(
  logs.some((value) =>
    value.includes("enforcement_fallback:natural_boundary_count_mismatch"),
  ),
);
assert.ok(logs.some((value) => value.includes("hostAction=explicit_passthrough")));
assert.ok(logs.some((value) => value.includes("actualBubbles=1")));

logs.length = 0;
sent.length = 0;
failAfter = 1;
await dispatch("before_prompt_build", { prompt: "two" }, ctx);
const partialResult = await dispatch(
  "message_sending",
  {
    content: "第一句可以发送。第二句会模拟失败。",
    to: "wx-owner@im.wechat",
    metadata: { channel: "openclaw-weixin" },
  },
  ctx,
);
assert.equal(partialResult.cancelReason, "yogurt_unified_outbound_partial");
assert.equal(partialResult.metadata.sentCount, 1);
assert.ok(logs.some((value) => value.includes("outcome=partial")));
assert.ok(logs.some((value) => value.includes("enforced_partial_delivery")));

api.pluginConfig.stickerEnabled = true;
logs.length = 0;
await dispatch("before_prompt_build", { prompt: "one" }, ctx);
const stickerSuccessResult = await dispatch(
  "message_sending",
  {
    content: "sticker-success",
    to: "wx-owner@im.wechat",
    metadata: { channel: "openclaw-weixin" },
  },
  ctx,
);
assert.deepEqual(stickerSuccessResult, {
  content: "sticker-success",
  cancel: false,
});
assert.ok(
  logs.some((value) =>
    value.includes("v4.3 outbound enforced") &&
    value.includes("sticker=pending") &&
    value.includes("stickerReason=delivery_scheduled"),
  ),
);
await new Promise((resolve) => setTimeout(resolve, 15));
assert.ok(
  logs.some((value) =>
    value.includes("v4.3 outbound finalized") &&
    value.includes("mode=enforced") &&
    value.includes("actualBubbles=1") &&
    value.includes("sticker=sent") &&
    value.includes("stickerReason=media_sent") &&
    value.includes("finalStage=sticker"),
  ),
);
assert.ok(logs.every((value) => !value.includes("sticker=unknown")));

logs.length = 0;
await dispatch("before_prompt_build", { prompt: "one" }, ctx);
await dispatch(
  "message_sending",
  {
    content: "sticker-failure",
    to: "wx-owner@im.wechat",
    metadata: { channel: "openclaw-weixin" },
  },
  ctx,
);
await new Promise((resolve) => setTimeout(resolve, 15));
assert.ok(
  logs.some((value) =>
    value.includes("v4.3 outbound finalized") &&
    value.includes("sticker=failed") &&
    value.includes("stickerReason=weixin_send_media_unavailable") &&
    value.includes("sticker_failed"),
  ),
);

logs.length = 0;
await dispatch("before_prompt_build", { prompt: "one" }, ctx);
await dispatch(
  "message_sending",
  {
    content: "sticker-skipped",
    to: "wx-owner@im.wechat",
    metadata: { channel: "openclaw-weixin" },
  },
  ctx,
);
assert.ok(
  logs.some((value) =>
    value.includes("v4.3 outbound enforced") &&
    value.includes("sticker=skipped") &&
    value.includes("stickerReason=below_threshold"),
  ),
);
assert.equal(
  logs.some((value) => value.includes("v4.3 outbound finalized")),
  false,
  "terminal skipped decisions must not create a pending finalizer",
);

logs.length = 0;
api.pluginConfig.stickerEnabled = false;
api.pluginConfig.unifiedOutboundEnforceEnabled = false;
await dispatch("before_prompt_build", { prompt: "two" }, ctx);
await dispatch(
  "message_sending",
  {
    content: "legacy-three",
    to: "wx-owner@im.wechat",
    metadata: { channel: "openclaw-weixin" },
  },
  ctx,
);
assert.equal(logs.some((value) => value.includes("v4.3 outbound intent ready")), false);
assert.equal(logs.some((value) => value.includes("v4.3 outbound enforced")), false);
assert.equal(logs.some((value) => value.includes("v4.3 outbound shadow")), false);
assert.equal(logs.some((value) => value.includes("v4.3 outbound finalized")), false);

console.log("v4.3 shadow, enforcement, and sticker finalization runtime: ok");
JS
