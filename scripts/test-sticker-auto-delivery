#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

command -v node >/dev/null 2>&1 || {
  echo "sticker outbound adapter: skipped (node not found)"
  exit 0
}

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

TEST_ROOT="$TMP_DIR/plugin-test"
FAKE_REPO="$TMP_DIR/repo"
mkdir -p \
  "$TEST_ROOT/node_modules/openclaw/plugin-sdk" \
  "$FAKE_REPO/social_layer/src" \
  "$FAKE_REPO/social_layer/config" \
  "$FAKE_REPO/assets/stickers/images"

for source in \
  index-v2.ts \
  sticker-plugin-utils.ts \
  sticker-selection.ts \
  sticker-turn.ts \
  sticker-v21-utils.ts \
  sticker-lifecycle.ts \
  turn-correlation.ts; do
  cp "$REPO_ROOT/integrations/openclaw/$source" "$TEST_ROOT/$source"
done

cat > "$TEST_ROOT/node_modules/openclaw/package.json" <<'JSON'
{
  "name": "openclaw",
  "version": "0.0.0-test",
  "type": "module",
  "exports": {
    "./plugin-sdk/plugin-entry": "./plugin-sdk/plugin-entry.js"
  }
}
JSON

cat > "$TEST_ROOT/node_modules/openclaw/plugin-sdk/plugin-entry.js" <<'JS'
export function definePluginEntry(definition) {
  return definition;
}
JS

printf 'fake-webp' > "$FAKE_REPO/assets/stickers/images/sticker-test123.webp"

# Keep this fixture independent from local Python cold-start / shim latency.
# runBridge only requires an executable that accepts stdin JSON and emits stdout JSON;
# the real Python bridge is covered by the adapter/Python tests elsewhere in the suite.
cat > "$TMP_DIR/fake-bridge" <<'SH'
#!/bin/sh
set -eu

request="$(cat)"
case "$request" in
  *'"explicit_sticker_request":true'*) ;;
  *)
    echo "explicit_sticker_request was not forwarded" >&2
    exit 2
    ;;
esac

case "$request" in
  *"模拟无候选"*)
    cat <<'JSON'
{"social_context":"[Yogurt Social State]\nscene: playful","sticker_candidates":[],"sticker_decision":{"should_send":false,"mode":"explicit_specific","score":0,"threshold":5,"intents":[],"reasons":["no_candidates"],"deferred":false}}
JSON
    ;;
  *)
    cat <<'JSON'
{"social_context":"[Yogurt Social State]\nscene: playful","sticker_candidates":[{"id":"sticker-test123","file":"images/sticker-test123.webp","description":"一只猫咪正在卖萌","score":9,"scenes":["playful"]}],"sticker_decision":{"should_send":true,"mode":"explicit_specific","score":9,"threshold":5,"intents":["playful"],"reasons":["explicit_request"],"deferred":false}}
JSON
    ;;
esac
SH
chmod +x "$TMP_DIR/fake-bridge"

YOGURT_STICKER_AGENT_END_DELAY_MS=10 \
node --experimental-strip-types --input-type=module - \
  "$TEST_ROOT" "$FAKE_REPO" "$TMP_DIR/fake-bridge" <<'JS'
import assert from "node:assert/strict";
import { pathToFileURL } from "node:url";

const [testRoot, fakeRepo, fakeBridge] = process.argv.slice(2);
const plugin = (await import(pathToFileURL(`${testRoot}/index-v2.ts`))).default;
const hooks = {};
const logs = [];
const sentMedia = [];
const openclawConfig = { channels: { "openclaw-weixin": {} } };
let toolFactory;
let loadedChannel;

async function waitFor(predicate, timeoutMs = 3000) {
  const startedAt = Date.now();
  while (Date.now() - startedAt < timeoutMs) {
    if (predicate()) return true;
    await new Promise((resolve) => setTimeout(resolve, 10));
  }
  return predicate();
}

function printDiagnostic(label) {
  console.error(`========== ${label} ==========`);
  console.error(`node=${process.version}`);
  console.error(`fakeBridge=${fakeBridge}`);
  console.error(`loadedChannel=${loadedChannel || "none"}`);
  console.error(`sentMedia=${sentMedia.length}`);
  console.error(logs.length > 0 ? logs.join("\n") : "(no plugin logs captured)");
  console.error("===============================================");
}

const pluginConfig = {
  enabled: true,
  pythonPath: fakeBridge,
  repoPath: fakeRepo,
  dbPath: `${fakeRepo}/memory.sqlite3`,
  defaultUserId: "owner",
  senderMap: { "wx-owner": "owner" },
  ownerSenderIds: [],
  unknownSenderPolicy: "skip",
  allowedChannels: ["openclaw-weixin"],
  onlyUserTurns: true,
  timeoutMs: 2500,
  maxMemories: 3,
  stickerEnabled: true,
  stickerConfigPath: `${fakeRepo}/social_layer/config/stickers.json`,
  stickerSelectionMode: "auto",
};

plugin.register({
  config: openclawConfig,
  pluginConfig,
  resolvePath(value) { return value; },
  logger: {
    info(message) { logs.push(String(message)); },
    warn(message) { logs.push(String(message)); },
  },
  registerTool(definition) { toolFactory = definition; },
  on(name, handler) { hooks[name] = handler; },
  runtime: {
    channel: {
      outbound: {
        async loadAdapter(channel) {
          loadedChannel = channel;
          return {
            async sendMedia(params) {
              sentMedia.push(params);
              return { channel, messageId: `media-${sentMedia.length}` };
            },
          };
        },
      },
    },
  },
});

assert.equal(typeof hooks.before_prompt_build, "function");
assert.equal(typeof hooks.agent_end, "function");
assert.equal(typeof hooks.message_sent, "function");
assert.equal(typeof hooks.reply_payload_sending, "function");
assert.equal(toolFactory({ sessionKey: "session-auto" }), null);

const context = {
  senderId: "wx-owner",
  channel: "openclaw-weixin",
  chatId: "wx-owner",
  sessionKey: "session-agent-end",
  accountId: "weixin-account",
};
const promptResult = await hooks.before_prompt_build(
  { prompt: "酸奶，发一个卖萌的表情包过来", context: { pluginConfig } },
  context,
);
if (!promptResult?.prependContext) printDiagnostic("sticker adapter pre-reply diagnostic");
assert.ok(promptResult?.prependContext, "before_prompt_build returned no context; see diagnostic logs above");
assert.match(promptResult.prependContext, /\[Yogurt Sticker Delivery\]/);
assert.doesNotMatch(promptResult.prependContext, /\[Yogurt Sticker Candidates\]/);
assert.doesNotMatch(promptResult.prependContext, /一只猫咪正在卖萌/);
assert.match(promptResult.prependContext, /不要描述、解释或虚构表情包画面/);

await hooks.agent_end(
  { success: true, messages: [{ role: "assistant", content: "来啦～" }] },
  context,
);
const firstDelivered = await waitFor(() => sentMedia.length >= 1);
if (!firstDelivered) printDiagnostic("sticker adapter agent_end delivery diagnostic");
assert.equal(firstDelivered, true, "agent_end sticker delivery did not complete in time");
assert.equal(loadedChannel, "openclaw-weixin");
assert.equal(sentMedia.length, 1);
assert.equal(sentMedia[0].cfg, openclawConfig);
assert.equal(sentMedia[0].to, "wx-owner");
assert.equal(sentMedia[0].text, "");
assert.equal(sentMedia[0].accountId, "weixin-account");
assert.match(
  sentMedia[0].mediaUrl,
  /assets\/stickers\/images\/sticker-test123\.webp$/,
);
assert.ok(logs.some((message) => message.includes("send decision trigger=agent_end")));
assert.ok(
  logs.some((message) =>
    message.includes("sticker media sent trigger=channel_outbound_adapter mode=auto"),
  ),
);

const fallbackContext = { ...context, sessionKey: "session-message-sent" };
await hooks.before_prompt_build(
  { prompt: "酸奶，再发一个卖萌的表情包", context: { pluginConfig } },
  fallbackContext,
);
await hooks.agent_end({ success: true }, fallbackContext);
await hooks.message_sent(
  { success: true, content: "再来一张～", to: "wx-owner", accountId: "weixin-account" },
  fallbackContext,
);
const secondDelivered = await waitFor(() => sentMedia.length >= 2);
if (!secondDelivered) printDiagnostic("sticker adapter message_sent delivery diagnostic");
assert.equal(secondDelivered, true, "message_sent sticker delivery did not complete in time");
assert.equal(sentMedia.length, 2, "message_sent must provide final-text fallback");

const unavailableContext = { ...context, sessionKey: "session-unavailable" };
const unavailableResult = await hooks.before_prompt_build(
  { prompt: "酸奶，发一个表情包，模拟无候选", context: { pluginConfig } },
  unavailableContext,
);
assert.match(unavailableResult.prependContext, /\[Yogurt Sticker Request\]/);
assert.match(unavailableResult.prependContext, /没有找到足够相关且安全的候选/);
assert.match(unavailableResult.prependContext, /绝对不要描述、解释、复述或虚构/);
assert.doesNotMatch(unavailableResult.prependContext, /一只猫咪正在卖萌/);

await hooks.agent_end(
  { success: true, messages: [{ role: "assistant", content: "这次没发出来。" }] },
  unavailableContext,
);
await new Promise((resolve) => setTimeout(resolve, 50));
assert.equal(sentMedia.length, 2, "no candidate must not send media");

console.log("sticker outbound adapter v2.1: ok");
JS