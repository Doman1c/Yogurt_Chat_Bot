#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

command -v node >/dev/null 2>&1 || {
  echo "sticker outbound adapter: skipped (node not found)"
  exit 0
}

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

TEST_ROOT="$TMP_DIR/plugin-test"
FAKE_REPO="$TMP_DIR/repo"
mkdir -p \
  "$TEST_ROOT/node_modules/openclaw/plugin-sdk" \
  "$FAKE_REPO/social_layer/src" \
  "$FAKE_REPO/social_layer/config" \
  "$FAKE_REPO/assets/stickers/images"

cp "$REPO_ROOT/integrations/openclaw/index-v2.ts" "$TEST_ROOT/index-v2.ts"
cp "$REPO_ROOT/integrations/openclaw/sticker-plugin-utils.ts" \
  "$TEST_ROOT/sticker-plugin-utils.ts"
cp "$REPO_ROOT/integrations/openclaw/sticker-selection.ts" \
  "$TEST_ROOT/sticker-selection.ts"

cat > "$TEST_ROOT/node_modules/openclaw/package.json" <<'JSON'
{
  "name": "openclaw",
  "version": "0.0.0-test",
  "type": "module",
  "exports": {
    "./plugin-sdk/plugin-entry": "./plugin-sdk/plugin-entry.js"
  }
}
JSON

cat > "$TEST_ROOT/node_modules/openclaw/plugin-sdk/plugin-entry.js" <<'JS'
export function definePluginEntry(definition) {
  return definition;
}
JS

printf 'fake-webp' > "$FAKE_REPO/assets/stickers/images/sticker-test123.webp"

cat > "$FAKE_REPO/social_layer/config/stickers.json" <<'JSON'
{
  "delivery_delay_ms": 10,
  "delivery_max_bytes": 10485760,
  "explicit_min_score": 5,
  "proactive_min_score": 7,
  "proactive_min_margin": 2,
  "global_cooldown_seconds": 300,
  "scene_cooldown_seconds": 900,
  "default_sticker_cooldown_seconds": 1800,
  "max_stickers_per_hour": 4
}
JSON

cat > "$TMP_DIR/fake-python" <<'PY'
#!/usr/bin/env python3
import json
import sys

request = json.load(sys.stdin)
if request.get("explicit_sticker_request") is not True:
    raise SystemExit("explicit_sticker_request was not forwarded")

message = request.get("message", "")
if "模拟无候选" in message:
    payload = {
        "social_context": "[Yogurt Social State]\nscene: playful",
        "sticker_candidates": [],
    }
else:
    payload = {
        "social_context": (
            "[Yogurt Social State]\nscene: playful\n\n"
            "[Yogurt Sticker Candidates]\n- sticker_id: sticker-test123"
        ),
        "sticker_candidates": [
            {
                "id": "sticker-test123",
                "file": "images/sticker-test123.webp",
                "description": "一只猫咪正在卖萌",
                "score": 9,
                "scenes": ["playful"],
            }
        ],
    }
json.dump(payload, sys.stdout, ensure_ascii=False)
PY
chmod +x "$TMP_DIR/fake-python"

YOGURT_STICKER_AGENT_END_DELAY_MS=10 \
node --experimental-strip-types --input-type=module - \
  "$TEST_ROOT" "$FAKE_REPO" "$TMP_DIR/fake-python" <<'JS'
import assert from "node:assert/strict";
import { pathToFileURL } from "node:url";

const [testRoot, fakeRepo, fakePython] = process.argv.slice(2);
const plugin = (await import(pathToFileURL(`${testRoot}/index-v2.ts`))).default;
const hooks = {};
const logs = [];
const sentMedia = [];
const openclawConfig = { channels: { "openclaw-weixin": {} } };
let toolFactory;
let loadedChannel;

const pluginConfig = {
  enabled: true,
  pythonPath: fakePython,
  repoPath: fakeRepo,
  dbPath: `${fakeRepo}/memory.sqlite3`,
  defaultUserId: "owner",
  senderMap: { "wx-owner": "owner" },
  ownerSenderIds: [],
  unknownSenderPolicy: "skip",
  allowedChannels: ["openclaw-weixin"],
  onlyUserTurns: true,
  timeoutMs: 2500,
  maxMemories: 3,
  stickerEnabled: true,
  stickerConfigPath: `${fakeRepo}/social_layer/config/stickers.json`,
  stickerSelectionMode: "auto",
};

plugin.register({
  config: openclawConfig,
  pluginConfig,
  resolvePath(value) {
    return value;
  },
  logger: {
    info(message) {
      logs.push(String(message));
    },
    warn(message) {
      logs.push(String(message));
    },
  },
  registerTool(definition) {
    toolFactory = definition;
  },
  on(name, handler) {
    hooks[name] = handler;
  },
  runtime: {
    channel: {
      outbound: {
        async loadAdapter(channel) {
          loadedChannel = channel;
          return {
            async sendMedia(params) {
              sentMedia.push(params);
              return { channel, messageId: "media-message-1" };
            },
          };
        },
      },
    },
  },
});

assert.equal(typeof hooks.before_prompt_build, "function");
assert.equal(typeof hooks.agent_end, "function");
assert.equal(typeof hooks.message_sent, "function");
assert.equal(typeof hooks.reply_payload_sending, "function");
assert.equal(toolFactory({ sessionKey: "session-auto" }), null);

const promptResult = await hooks.before_prompt_build(
  {
    prompt: "酸奶，发一个卖萌的表情包过来",
    context: { pluginConfig },
  },
  {
    senderId: "wx-owner",
    channel: "openclaw-weixin",
    sessionKey: "session-auto",
    accountId: "weixin-account",
  },
);

assert.match(promptResult.prependContext, /\[Yogurt Sticker Delivery\]/);
assert.doesNotMatch(promptResult.prependContext, /\[Yogurt Sticker Candidates\]/);
assert.doesNotMatch(promptResult.prependContext, /一只猫咪正在卖萌/);
assert.match(promptResult.prependContext, /不要描述、解释或复述表情包画面/);

const weixinPayloadResult = await hooks.reply_payload_sending(
  {
    payload: { text: "来啦～" },
    kind: "final",
    channel: "openclaw-weixin",
    sessionKey: "session-auto",
  },
  {
    channelId: "openclaw-weixin",
    conversationId: "wx-owner",
    sessionKey: "session-auto",
    accountId: "weixin-account",
  },
);
assert.equal(
  weixinPayloadResult,
  undefined,
  "WeChat must not depend on reply_payload_sending",
);

hooks.agent_end(
  {
    success: true,
    messages: [{ role: "assistant", content: "来啦～" }],
  },
  {
    channel: "openclaw-weixin",
    chatId: "wx-owner",
    sessionKey: "session-auto",
    accountId: "weixin-account",
  },
);

hooks.message_sent(
  {
    success: true,
    content: "来啦～",
    to: "wx-owner",
    accountId: "weixin-account",
  },
  {
    channelId: "openclaw-weixin",
    conversationId: "wx-owner",
    sessionKey: "session-auto",
    accountId: "weixin-account",
  },
);

await new Promise((resolve) => setTimeout(resolve, 100));

assert.equal(loadedChannel, "openclaw-weixin");
assert.equal(sentMedia.length, 1);
assert.equal(sentMedia[0].cfg, openclawConfig);
assert.equal(sentMedia[0].to, "wx-owner");
assert.equal(sentMedia[0].text, "");
assert.equal(sentMedia[0].accountId, "weixin-account");
assert.match(
  sentMedia[0].mediaUrl,
  /assets\/stickers\/images\/sticker-test123\.webp$/,
);
assert.ok(
  logs.some((message) =>
    message.includes("sticker outbound scheduled trigger=message_sent mode=auto"),
  ),
);
assert.ok(
  logs.some((message) =>
    message.includes("sticker media sent trigger=channel_outbound_adapter mode=auto"),
  ),
);

const unavailableResult = await hooks.before_prompt_build(
  {
    prompt: "酸奶，发一个表情包，模拟无候选",
    context: { pluginConfig },
  },
  {
    senderId: "wx-owner",
    channel: "openclaw-weixin",
    sessionKey: "session-unavailable",
  },
);

assert.match(unavailableResult.prependContext, /\[Yogurt Sticker Request\]/);
assert.match(unavailableResult.prependContext, /没有找到可安全发送的候选/);
assert.match(unavailableResult.prependContext, /绝对不要描述、解释、复述或虚构/);
assert.doesNotMatch(unavailableResult.prependContext, /表情描述：/);
assert.doesNotMatch(unavailableResult.prependContext, /一只猫咪正在卖萌/);

hooks.agent_end(
  { success: true, messages: [{ role: "assistant", content: "这次没发出来。" }] },
  {
    channel: "openclaw-weixin",
    chatId: "wx-owner",
    sessionKey: "session-unavailable",
  },
);
await new Promise((resolve) => setTimeout(resolve, 40));
assert.equal(sentMedia.length, 1, "no candidate must not send media");

console.log("sticker outbound adapter: ok");
JS
