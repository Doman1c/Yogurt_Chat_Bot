#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

command -v node >/dev/null 2>&1 || {
  echo "sticker selection state: skipped (node not found)"
  exit 0
}

node --experimental-strip-types --input-type=module - "$REPO_ROOT" <<'JS'
import assert from "node:assert/strict";
import { pathToFileURL } from "node:url";

const repoRoot = process.argv[2];
const moduleUrl = pathToFileURL(
  `${repoRoot}/integrations/openclaw/sticker-selection.ts`,
).href;
const { StickerAutoPolicyStore, StickerSelectionStore } = await import(moduleUrl);

const store = new StickerSelectionStore({ ttlMs: 10_000, maxSnapshots: 8 });
const aliases = ["session:test-session", "sender:ilink:test-owner"];
const candidates = [
  {
    id: "sticker-0123456789ab",
    file: "images/sticker-0123456789ab.webp",
    description: "庆祝",
    score: 9,
    scenes: ["celebration"],
  },
  {
    id: "sticker-abcdef012345",
    file: "images/sticker-abcdef012345.webp",
    description: "得意",
    score: 6,
    scenes: ["playful"],
  },
];

store.register(aliases, candidates, 1_000);

const invalid = store.select(aliases, "sticker-not-current", 1_001);
assert.deepEqual(invalid, { status: "rejected", reason: "not_in_candidates" });

const selected = store.select(aliases, "sticker-0123456789ab", 1_002, {
  sessionKey: "test-session",
  policyKey: "session:test-session",
  mode: "auto",
  explicit: true,
});
assert.equal(selected.status, "selected");
assert.equal(selected.sticker.id, "sticker-0123456789ab");
assert.equal(selected.idempotent, false);
assert.equal(selected.pending.sessionKey, "test-session");
assert.equal(selected.pending.mode, "auto");

const repeated = store.select(aliases, "sticker-0123456789ab", 1_003);
assert.equal(repeated.status, "selected");
assert.equal(repeated.idempotent, true);

const second = store.select(aliases, "sticker-abcdef012345", 1_004);
assert.deepEqual(second, { status: "rejected", reason: "already_selected" });

const consumed = store.consumePendingBySnapshot(selected.pending.snapshotId, 1_005);
assert.equal(consumed?.sticker.id, "sticker-0123456789ab");
assert.equal(store.getPending(aliases, 1_006), undefined);

store.register(aliases, [candidates[1]], 2_000);
const stale = store.select(aliases, "sticker-0123456789ab", 2_001);
assert.deepEqual(stale, { status: "rejected", reason: "not_in_candidates" });
const refreshed = store.select(aliases, "sticker-abcdef012345", 2_002);
assert.equal(refreshed.status, "selected");

const expiredStore = new StickerSelectionStore({ ttlMs: 1_000, maxSnapshots: 8 });
expiredStore.register(aliases, candidates, 10_000);
const expired = expiredStore.select(aliases, "sticker-0123456789ab", 12_000);
assert.equal(expired.status, "rejected");
assert.equal(expired.reason, "snapshot_expired");

const policy = new StickerAutoPolicyStore();
const policyConfig = {
  explicitMinScore: 5,
  proactiveMinScore: 7,
  proactiveMinMargin: 2,
  globalCooldownSeconds: 300,
  sceneCooldownSeconds: 900,
  stickerCooldownSeconds: 1800,
  maxStickersPerHour: 4,
};

const explicitDecision = policy.choose(
  "session:explicit",
  [
    { ...candidates[0], score: 6 },
    { ...candidates[1], score: 5.5 },
  ],
  true,
  policyConfig,
  20_000,
);
assert.equal(explicitDecision.selected?.id, "sticker-0123456789ab");
assert.equal(explicitDecision.reason, "explicit");

const marginDecision = policy.choose(
  "session:margin",
  [
    { ...candidates[0], score: 9 },
    { ...candidates[1], score: 8 },
  ],
  false,
  policyConfig,
  30_000,
);
assert.equal(marginDecision.selected, undefined);
assert.equal(marginDecision.reason, "score_margin");

const proactiveDecision = policy.choose(
  "session:proactive",
  candidates,
  false,
  policyConfig,
  40_000,
);
assert.equal(proactiveDecision.selected?.id, "sticker-0123456789ab");
assert.equal(proactiveDecision.reason, "proactive");
policy.recordSent("session:proactive", proactiveDecision.selected, 40_000);

const cooldownDecision = policy.choose(
  "session:proactive",
  candidates,
  false,
  policyConfig,
  40_001,
);
assert.equal(cooldownDecision.selected, undefined);
assert.equal(cooldownDecision.reason, "global_cooldown");

const explicitBypassesCooldown = policy.choose(
  "session:proactive",
  candidates,
  true,
  policyConfig,
  40_002,
);
assert.equal(explicitBypassesCooldown.selected?.id, "sticker-0123456789ab");
assert.equal(explicitBypassesCooldown.reason, "explicit");

console.log("sticker selection and auto policy: ok");
JS