#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT
TEST_ROOT="$TMP_DIR/plugin-test"
mkdir -p "$TEST_ROOT/node_modules/openclaw/plugin-sdk"

for file in \
  v3-runtime.ts \
  multi-bubble.ts \
  turn-correlation.ts \
  outbound-coordinator.ts; do
  cp "$REPO_ROOT/integrations/openclaw/$file" "$TEST_ROOT/$file"
done

cat > "$TEST_ROOT/node_modules/openclaw/package.json" <<'JSON'
{
  "name": "openclaw",
  "version": "0.0.0-test",
  "type": "module",
  "exports": {
    "./plugin-sdk/plugin-entry": "./plugin-sdk/plugin-entry.js"
  }
}
JSON

cat > "$TEST_ROOT/node_modules/openclaw/plugin-sdk/plugin-entry.js" <<'JS'
export function definePluginEntry(definition) {
  return definition;
}
JS

cat > "$TEST_ROOT/sticker-v21-utils.ts" <<'TS'
export function assistantTextFromEvent(event: any): string | undefined {
  return typeof event?.content === "string" ? event.content : undefined;
}
TS

cat > "$TEST_ROOT/sticker-plugin-utils.ts" <<'TS'
export function asRecord(value: unknown): Record<string, unknown> {
  return value && typeof value === "object" && !Array.isArray(value)
    ? value as Record<string, unknown>
    : {};
}
export function optionalString(value: unknown): string | undefined {
  return typeof value === "string" && value.trim() ? value.trim() : undefined;
}
export function channelFromContext(ctx: any): string {
  return optionalString(ctx?.channelId) || "openclaw-weixin";
}
export function channelIsAllowed(): boolean {
  return true;
}
export function senderIdFromContext(ctx: any): string | undefined {
  return optionalString(ctx?.senderId);
}
export function contextAliases(ctx: any, channel: string, senderId?: string, event?: any): string[] {
  const aliases: string[] = [];
  if (ctx?.runId) aliases.push(`run:${ctx.runId}`);
  if (event?.runId) aliases.push(`run:${event.runId}`);
  if (ctx?.sessionKey) aliases.push(`session:${ctx.sessionKey}`);
  if (event?.sessionKey) aliases.push(`session:${event.sessionKey}`);
  if (senderId) aliases.push(`sender:${channel}:${senderId}`);
  if (event?.to) aliases.push(`target:${event.to}`);
  return aliases;
}
export function readConfig(api: any): any {
  return {
    enabled: true,
    pythonPath: "python3",
    repoPath: api.repoPath || ".",
    dbPath: "/tmp/unused.sqlite3",
  };
}
export function resolveUserId(): string {
  return "owner";
}
TS

node --experimental-strip-types --input-type=module - "$TEST_ROOT" <<'JS'
import assert from "node:assert/strict";
import { pathToFileURL } from "node:url";

const testRoot = process.argv[2];
const {
  CorrelationStore,
  summarizeCorrelationAliases,
} = await import(pathToFileURL(`${testRoot}/turn-correlation.ts`));
const { OutboundTurnStore } = await import(pathToFileURL(`${testRoot}/outbound-coordinator.ts`));
const { registerV3Runtime } = await import(pathToFileURL(`${testRoot}/v3-runtime.ts`));

// Strict correlation remains unchanged: a weak-only callback cannot consume a
// strong Turn unless the caller explicitly identifies itself as the parent path.
const strictStore = new CorrelationStore(5_000, 16);
strictStore.register(["trace:trace-parent", "session:shared"], { marker: "parent" });
assert.equal(strictStore.peek(["session:shared"]), undefined);
assert.equal(strictStore.peekParent(["session:shared"])?.marker, "parent");

const summary = summarizeCorrelationAliases([
  "trace:secret-trace-value",
  "session:secret-session-value",
  "sender:openclaw-weixin:secret-user",
]);
assert.deepEqual(summary.strongKinds, ["trace"]);
assert.deepEqual(summary.weakKinds, ["sender", "session"]);
assert.equal(summary.aliasCount, 3);
assert.equal(JSON.stringify(summary).includes("secret"), false, "diagnostics must never expose alias values");

// A true top-level final callback may arrive weak-only. OutboundTurnStore may
// recover the one unique parent while CorrelationStore itself stays strict.
const outbound = new OutboundTurnStore(5_000, 16);
outbound.register(
  ["trace:trace-outbound", "session:outbound", "peer:wechat:owner"],
  { bubble_target: 2, state_version: 501 },
);
const weakParent = outbound.consumeWithMatch([
  "session:outbound",
  "peer:wechat:owner",
]);
assert.equal(weakParent.match, "weak_parent");
assert.equal(weakParent.intent?.bubbleTarget, 2);
assert.equal(weakParent.intent?.stateVersion, 501);

// Earlier observed OpenClaw shape: before_prompt_build carries traceId while
// final message_sending carries runId and all weak aliases change. The guarded
// top-level path may recover exactly one pending Turn across disjoint strong
// namespaces.
const crossNamespace = new OutboundTurnStore(5_000, 16);
crossNamespace.register(
  ["trace:trace-real-parent", "session:registration-shape"],
  { bubble_target: 2, state_version: 701 },
);
const crossStrict = crossNamespace.consumeWithMatch([
  "run:run-real-parent",
  "peer:openclaw-weixin:delivery-shape",
  "target:delivery-shape",
]);
assert.equal(crossStrict.match, "miss");
assert.equal(crossNamespace.size(), 1);
const crossParent = crossNamespace.consumeTopLevelWithMatch([
  "run:run-real-parent",
  "peer:openclaw-weixin:delivery-shape",
  "target:delivery-shape",
]);
assert.equal(crossParent.match, "cross_namespace_parent");
assert.equal(crossParent.intent?.stateVersion, 701);
assert.equal(crossNamespace.size(), 0);

// Latest real-device shape: registration and final delivery both carry runIds,
// but OpenClaw replaces the runId between phases. Strict correlation still
// rejects it; the guarded top-level parent path may recover only when one exact
// weak alias identifies exactly one candidate.
const sameNamespaceShared = new OutboundTurnStore(5_000, 16);
sameNamespaceShared.register(
  ["run:run-inbound", "peer:openclaw-weixin:owner", "session:before"],
  { bubble_target: 2, state_version: 705 },
);
const sameNamespaceStrict = sameNamespaceShared.consumeWithMatch([
  "run:run-outbound",
  "peer:openclaw-weixin:owner",
  "target:owner",
]);
assert.equal(sameNamespaceStrict.match, "miss");
assert.equal(sameNamespaceShared.size(), 1);
const sameNamespaceParent = sameNamespaceShared.consumeTopLevelWithMatch([
  "run:run-outbound",
  "peer:openclaw-weixin:owner",
  "target:owner",
]);
assert.equal(sameNamespaceParent.intent?.stateVersion, 705);
assert.equal(sameNamespaceShared.size(), 0);

// Same-namespace disagreement without any exact weak overlap is never eligible
// for top-level recovery.
const sameNamespaceNoWeak = new OutboundTurnStore(5_000, 16);
sameNamespaceNoWeak.register(["run:run-old", "session:before"], {
  bubble_target: 1,
  state_version: 702,
});
const sameNamespaceMiss = sameNamespaceNoWeak.consumeTopLevelWithMatch([
  "run:run-new",
  "target:after",
]);
assert.equal(sameNamespaceMiss.match, "miss");
assert.equal(sameNamespaceNoWeak.size(), 1);

// Two same-peer pending Turns are ambiguous and must not be guessed even though
// both share the delivery peer.
const ambiguousSamePeer = new OutboundTurnStore(5_000, 16);
ambiguousSamePeer.register(
  ["run:run-a", "peer:openclaw-weixin:owner", "session:a"],
  { bubble_target: 1, state_version: 706 },
);
ambiguousSamePeer.register(
  ["run:run-b", "peer:openclaw-weixin:owner", "session:b"],
  { bubble_target: 2, state_version: 707 },
);
const ambiguousSamePeerMiss = ambiguousSamePeer.consumeTopLevelWithMatch([
  "run:run-final",
  "peer:openclaw-weixin:owner",
]);
assert.equal(ambiguousSamePeerMiss.match, "miss");
assert.equal(ambiguousSamePeer.size(), 2);

// More than one pending Turn is ambiguous when there is no weak overlap too.
const ambiguousCross = new OutboundTurnStore(5_000, 16);
ambiguousCross.register(["trace:trace-a", "session:a"], {
  bubble_target: 1,
  state_version: 703,
});
ambiguousCross.register(["trace:trace-b", "session:b"], {
  bubble_target: 2,
  state_version: 704,
});
const ambiguousCrossMiss = ambiguousCross.consumeTopLevelWithMatch([
  "run:run-ambiguous",
  "target:after",
]);
assert.equal(ambiguousCrossMiss.match, "miss");
assert.equal(ambiguousCross.size(), 2);

// A normal strong callback is still conservative; after a strong miss, a weak
// recursive child cannot steal the old parent.
const conflict = new OutboundTurnStore(5_000, 16);
conflict.register(["run:run-old", "session:conflict"], {
  bubble_target: 1,
  state_version: 601,
});
const strongMiss = conflict.consumeWithMatch(["run:run-new", "session:conflict"]);
assert.equal(strongMiss.match, "miss");
const weakChild = conflict.consumeWithMatch(["session:conflict"]);
assert.equal(weakChild.match, "miss");
assert.equal(conflict.peek(["run:run-old"])?.stateVersion, 601);

// Real V3 regression from the Mac: before_prompt_build has an inbound runId,
// final message_sending has a different outbound runId, while the same peer is
// preserved. It must split into two bubbles. Recursive child callbacks remain
// protected by the existing bubble fingerprint guard.
const hooks = new Map();
const logs = [];
const sent = [];
const api = {
  repoPath: testRoot,
  pluginConfig: {
    autoMemoryEnabled: false,
    multiBubbleEnabled: true,
    multiBubbleMinChars: 8,
    multiBubbleMaxChars: 360,
    multiBubbleMaxBubbles: 3,
    multiBubbleDelayMs: 0,
  },
  config: {},
  logger: {
    info(message) { logs.push(String(message)); },
    warn(message) { logs.push(String(message)); },
  },
  on(name, handler, options = {}) {
    const values = hooks.get(name) || [];
    values.push({ handler, priority: options.priority || 0 });
    hooks.set(name, values);
  },
  runtime: {
    channel: {
      outbound: {
        async loadAdapter() {
          return {
            async sendText({ to, text }) {
              sent.push(text);
              await dispatch(
                "message_sending",
                {
                  content: text,
                  to,
                  metadata: { channel: "openclaw-weixin" },
                },
                {
                  channelId: "openclaw-weixin",
                  senderId: "wx-delivery-child@im.wechat",
                  sessionKey: "session-child-only",
                },
              );
            },
          };
        },
      },
    },
  },
};

async function dispatch(name, event, ctx) {
  let result;
  const ordered = [...(hooks.get(name) || [])].sort(
    (left, right) => right.priority - left.priority,
  );
  for (const item of ordered) {
    const current = await item.handler(event, ctx);
    if (current !== undefined) result = current;
  }
  return result;
}

registerV3Runtime(api);
const owner = "wx-owner@im.wechat";
const inboundCtx = {
  channelId: "openclaw-weixin",
  senderId: owner,
  sessionKey: "session-registration-only",
  runId: "run-v3-inbound",
};
await dispatch(
  "before_prompt_build",
  {
    prompt: "测试真实 run 到新 run 的 parent 最终回调",
  },
  inboundCtx,
);

const parentText = "第一句足够自然。第二句也足够自然。";
const result = await dispatch(
  "message_sending",
  {
    content: parentText,
    to: owner,
    runId: "run-v3-outbound",
    metadata: { channel: "openclaw-weixin" },
  },
  {
    channelId: "openclaw-weixin",
  },
);

assert.equal(result?.cancel, true);
assert.equal(result?.cancelReason, "yogurt_multi_bubble");
assert.deepEqual(sent, ["第一句足够自然。", "第二句也足够自然。"]);
assert.ok(
  logs.some((value) =>
    value.includes("multi bubble registered") &&
    value.includes("strongKinds=run") &&
    value.includes("pendingAfter=1")
  ),
);
assert.ok(
  logs.some((value) =>
    value.includes("multi bubble correlation") &&
    value.includes("strongKinds=run") &&
    value.includes("pendingBefore=1") &&
    value.includes("match=weak_parent")
  ),
);
assert.ok(logs.some((value) => value.includes("multi bubble sent count=2")));
assert.equal(logs.some((value) => value.includes("run-v3-inbound")), false);
assert.equal(logs.some((value) => value.includes(owner)), false);

console.log("v4.3 real run-to-run parent recovery, ambiguity guard, child guard, and bounded diagnostics: ok");
JS
