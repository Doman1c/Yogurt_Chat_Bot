{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yogurt.local/schemas/stickers.schema.json",
  "title": "Yogurt Sticker Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "settings", "stickers"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minimum_score",
        "global_cooldown_seconds",
        "scene_cooldown_seconds",
        "default_sticker_cooldown_seconds",
        "max_stickers_per_hour"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "minimum_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "global_cooldown_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "scene_cooldown_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "default_sticker_cooldown_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        },
        "max_stickers_per_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "allowed_channels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": ["openclaw-weixin"]
        }
      }
    },
    "stickers": {
      "type": "array",
      "items": { "$ref": "#/$defs/sticker" }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 80 },
      "uniqueItems": true
    },
    "scene": {
      "type": "string",
      "enum": [
        "casual",
        "technical",
        "playful",
        "comfort",
        "celebration",
        "serious"
      ]
    },
    "relationship": {
      "type": "string",
      "enum": ["new", "familiar", "close", "owner"]
    },
    "sticker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "enabled",
        "scenes",
        "emotions",
        "keywords",
        "tone",
        "relationships",
        "weight",
        "description",
        "source",
        "reviewed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"
        },
        "file": {
          "type": "string",
          "pattern": "^images/[A-Za-z0-9][A-Za-z0-9._/-]*\\.(png|jpg|jpeg|webp|gif)$"
        },
        "enabled": { "type": "boolean" },
        "scenes": {
          "type": "array",
          "items": { "$ref": "#/$defs/scene" },
          "uniqueItems": true,
          "minItems": 1
        },
        "emotions": { "$ref": "#/$defs/nonEmptyStringArray" },
        "keywords": { "$ref": "#/$defs/nonEmptyStringArray" },
        "tone": { "$ref": "#/$defs/nonEmptyStringArray" },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationship" },
          "uniqueItems": true,
          "minItems": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "cooldown_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "source": {
          "type": "string",
          "enum": ["manual", "auto", "imported"]
        },
        "reviewed": { "type": "boolean" },
        "content_warning": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "violence",
              "sexual",
              "medical",
              "political",
              "personal_data",
              "copyright_unclear"
            ]
          },
          "uniqueItems": true,
          "default": ["none"]
        }
      }
    }
  }
}
